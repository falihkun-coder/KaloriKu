rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===== App lain di personal-hub (Manga Tracker, SF6 Combo Builder) =====
    // Dipertahankan sesuai perilaku rules lama (terbuka) biar nggak breaking.
    match /mangas/{id} {
      allow read, write: if true;
    }
    match /characters/{id} {
      allow read, write: if true;
    }
    match /combos/{id} {
      allow read, write: if true;
    }

    // ===== KaloriKu — data per-user, hanya pemilik yang bisa akses =====
    match /foodEntries/{entryId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /weights/{weightId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /waterLogs/{logId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /meals/{mealId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    match /goals/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Kode sekali-pakai link bot: client cuma boleh bikin punya sendiri;
    // dibaca/dihapus oleh webhook via Admin SDK (bypass rules).
    match /telegramLinks/{code} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /discordLinks/{code} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
  }
}
